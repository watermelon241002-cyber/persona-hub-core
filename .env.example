PERSONA_HUB_ENV=development
PERSONA_HUB_HOST=127.0.0.1
PERSONA_HUB_PORT=18080
PERSONA_HUB_DATABASE=./data/persona_hub.sqlite3
PERSONA_HUB_PERSONA_FILE=./prompts/persona.example.md
PERSONA_HUB_WORKER_TOKEN=replace-with-a-long-random-token
# REST API bearer token. Empty disables auth for local development;
# production refuses to start without it.
PERSONA_HUB_API_TOKEN=
PERSONA_HUB_DEFAULT_PROVIDER=echo

# Optional OpenAI-compatible provider. Never commit real values.
OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=replace-with-model-id

# The people's own time zone (IANA name or offset such as +08:00).
PERSONA_HUB_TIMEZONE=UTC
PERSONA_HUB_USER_NAME=User
PERSONA_HUB_ASSISTANT_NAME=Assistant

# Background memory work (reflection, summaries) on the endpoint above.
PERSONA_HUB_MEMORY_MODEL=
PERSONA_HUB_MEMORY_REFLECTION=0
PERSONA_HUB_MEMORY_SUMMARIES=0

# Desire system. PERSONA_HUB_DESIRE runs the heartbeat; the other flags
# decide what it may do. All off by default.
PERSONA_HUB_DESIRE=0
PERSONA_HUB_DESIRE_STATE=./data/desire_state.json
PERSONA_HUB_DESIRE_QUIET_HOURS=02-08
PERSONA_HUB_DESIRE_DRIVEN=0
PERSONA_HUB_DESIRE_COUPLING=0
PERSONA_HUB_DESIRE_BASELINE_DRIFT=0
PERSONA_HUB_DESIRE_HEARTBEAT_AUTONOMY=0
PERSONA_HUB_DESIRE_SELF_DRIVE=0
PERSONA_HUB_DESIRE_SWING=0
