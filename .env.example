PERSONA_HUB_ENV=development
PERSONA_HUB_HOST=127.0.0.1
PERSONA_HUB_PORT=18080
PERSONA_HUB_DATABASE=./data/persona_hub.sqlite3
PERSONA_HUB_PERSONA_FILE=./prompts/persona.example.md
PERSONA_HUB_WORKER_TOKEN=replace-with-a-long-random-token
# REST API bearer token. Empty disables auth for local development;
# production refuses to start without it.
PERSONA_HUB_API_TOKEN=
PERSONA_HUB_DEFAULT_PROVIDER=echo

# Optional OpenAI-compatible provider. Never commit real values.
OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=replace-with-model-id
